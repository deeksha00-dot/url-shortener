# Copy this file to .env and change the values.
# NEVER commit your real .env file (it is already in .gitignore).

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Redis. Locally this is 127.0.0.1; docker-compose overrides REDIS_HOST to "redis".
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Where the SQLite file lives. Leave empty to use ./db.sqlite3.
# docker-compose sets this to /data/db.sqlite3 (a named volume).
SQLITE_PATH=

# Seconds a short code stays cached in Redis
CACHE_TTL_SECONDS=300

# Only needed if you open the frontend from a different origin (e.g. VS Code Live Server)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
